# Supabase (recomendado): Dashboard → Connect → Session pooler (porta 5432)
# Exemplo (substitua PROJECT_REF, REGION e a senha):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Opcional: URL Direct (porta 5432 em db.PROJECT_REF.supabase.co) para migrations
# se o pooler falhar no `prisma migrate`. Se omitido, usa DATABASE_URL.
# DIRECT_URL="postgresql://postgres:SUA_SENHA@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
#
# Alternativa local (Docker): docker compose up -d
# DATABASE_URL="postgresql://finance:finance@localhost:5432/finance?schema=public"

DATABASE_URL="postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres:SUA_SENHA@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

PORT=3333
WEB_ORIGIN="http://localhost:5173"

{
  "name": "@finance/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @finance/shared && npm run db:generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@finance/shared": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.7.0",
    "pg": "^8.21.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "prisma": "^7.1.0",
    "tsx": "^4.21.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  income
  expense
  transfer
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  budget         Decimal?      @db.Decimal(12, 2)
  deadline       DateTime?
  impactsBalance Boolean       @default(true)
  color          String
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  color        String
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  date        DateTime
  account     String
  categoryId  String
  projectId   String?
  category    Category        @relation(fields: [categoryId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])
}

model Goal {
  id            String   @id @default(cuid())
  name          String
  targetAmount  Decimal  @db.Decimal(12, 2)
  currentAmount Decimal  @db.Decimal(12, 2)
  deadline      DateTime
  category      String
}

model UpcomingPayment {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(12, 2)
  dueDate     DateTime
  category    String
  isPaid      Boolean  @default(false)
}

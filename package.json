{
  "name": "finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @finance/web",
    "build:web": "npm run build -w @finance/web",
    "lint:web": "npm run lint -w @finance/web",
    "preview:web": "npm run preview -w @finance/web",
    "dev:api": "node scripts/api.mjs spring-boot:run",
    "build:api": "node scripts/api.mjs -B package -DskipTests",
    "test:api": "node scripts/api.mjs -B test",
    "start:api": "cd apps/api && java -jar target/finance-api.jar",
    "build:shared": "npm run build -w @finance/shared",
    "lint:shared": "npm run lint -w @finance/shared",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "lint": "npm run lint:shared && npm run lint:web",
    "test": "npm run test:api",
    "typecheck": "npm run build:shared && npm run build:web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  }
}
